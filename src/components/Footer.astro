---
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}
const { profile } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap fw__top">
    <div>
      <p class="fw__name"><b>{profile.name}</b></p>
      <p class="faint mono">{profile.location}</p>
    </div>
    <nav class="fw__col" aria-label="Site">
      <p class="fw__title mono">Site</p>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/substack">Substack</a>
      <a href="/projects">Projects</a>
    </nav>
    <nav class="fw__col" aria-label="Elsewhere">
      <p class="fw__title mono">Elsewhere</p>
      <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.links.substack} target="_blank" rel="noopener">Substack ↗</a>
      <a href={profile.links.instagram} target="_blank" rel="noopener">Instagram</a>
    </nav>
    <nav class="fw__col" aria-label="Contact">
      <p class="fw__title mono">Contact</p>
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href="/resume.pdf">Resume (PDF)</a>
      <a href="/.well-known/security.txt">security.txt</a>
    </nav>
  </div>
  <div class="wrap fw__base mono">
    <span class="faint">© {year} {profile.name}</span>
    <span class="faint"> · Astro · three.js · TypeScript</span>
  </div>
</footer>
