---
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}
const { profile } = Astro.props;
---
<section class="vault" id="top" aria-label="Introduction">
  <div class="vault__stage">
    <canvas class="vault__canvas" aria-hidden="true"></canvas>
    <div class="vault__copy wrap">
      <p class="eyebrow">Senior Software Engineer @ Founda · India</p>
      <h1 class="vault__name">
        <span class="vault__line" data-cipher>{profile.given}</span>
        <span class="vault__line vault__line--soft" data-cipher>{profile.family}</span>
      </h1>
      <p class="vault__tagline">{profile.tagline}</p>
      <p class="vault__about">{profile.about}</p>
      <ul class="vault__chips" aria-label="Key facts">
        {profile.chips.map((c) => (
          <li class:list={['chip', { 'chip--hot': c.hot }]} title={c.title}>{c.label}</li>
        ))}
      </ul>
      <div class="vault__actions">
        <a class="btn btn--primary" href="/about">View profile →</a>
        <a class="btn" href="/projects">Projects</a>
        <a class="btn" href={profile.links.substack} target="_blank" rel="noopener">Substack</a>
      </div>
    </div>
    <p class="vault__hint mono" aria-hidden="true">scroll to explore ↓</p>
  </div>
</section>
<script src="../scripts/vault-scene.ts"></script>
