---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import instagram from '../data/instagram.json';

type Kind = 'photo' | 'carousel' | 'reel';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/instagram/**/*.{jpg,webp}', { eager: true });
const asset = (name: string): ImageMetadata => {
  const mod = files[`../assets/instagram/${name}`];
  if (!mod) throw new Error(`Missing Instagram asset: ${name}`);
  return mod.default;
};

const { profile, highlights } = instagram;

const posts = await Promise.all(
  instagram.posts.map(async (p) => {
    const src = asset(p.image);
    const [thumb, full] = await Promise.all([
      getImage({ src, width: 540, format: 'webp', quality: 72 }),
      getImage({ src, width: Math.min(1440, src.width), format: 'webp', quality: 80 }),
    ]);
    return {
      ...p,
      kind: p.kind as Kind,
      thumb: thumb.src,
      full: full.src,
      width: src.width,
      height: src.height,
    };
  }),
);

const hl = await Promise.all(
  highlights.map(async (h) => ({
    title: h.title,
    src: (await getImage({ src: asset(h.image), width: 150, format: 'webp' })).src,
  })),
);

const avatar = profile.avatar ? await getImage({ src: asset(profile.avatar), width: 320, format: 'webp' }) : null;

const viewerData = posts.map((p) => ({
  kind: p.kind,
  url: p.url,
  embed: `https://www.instagram.com/p/${p.code}/embed/`,
  full: p.full,
  width: p.width,
  height: p.height,
  caption: p.caption,
}));

const kindLabel: Record<Kind, string> = { photo: 'Photo', carousel: 'Carousel', reel: 'Reel' };
---
<BaseLayout
  title="Instagram"
  description="Frames from Hritik Rai's Instagram — cinematography, travel, and photos."
  current="instagram"
>
  <div class="wrap ig">
    <header class="ig__head">
      {avatar && <img class="ig__avatar" src={avatar.src} alt="" width="160" height="160" />}
      <div class="ig__who">
        <p class="eyebrow">Instagram · @{profile.handle}</p>
        <h1 class="section-title" data-cipher>Frames.</h1>
        <p class="ig__bio">
          {profile.bio.map((line) => <span>{line}</span>)}
        </p>
        <p class="ig__stats mono faint">{profile.posts} posts · {profile.category}</p>
        <a class="btn btn--primary" href={profile.url} target="_blank" rel="noopener">Follow on Instagram ↗</a>
      </div>
    </header>

    <ul class="ig__highlights" aria-label="Story highlights">
      {hl.map((h) => (
        <li>
          <a href={profile.url} target="_blank" rel="noopener" class="ig__hl">
            <img src={h.src} alt="" width="72" height="72" loading="lazy" />
            <span>{h.title}</span>
          </a>
        </li>
      ))}
    </ul>

    <ul class="ig__grid">
      {posts.map((p, i) => (
        <li>
          <a class="ig__tile" href={p.url} target="_blank" rel="noopener" data-i={i} aria-label={`${kindLabel[p.kind]}: ${p.caption.slice(0, 80) || 'Instagram post'}`}>
            <img src={p.thumb} alt="" width="540" height={Math.round((540 * p.height) / p.width)} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            <span class="ig__badges">
              {p.pinned && <span class="ig__badge mono">Pinned</span>}
              {p.kind !== 'photo' && <span class="ig__badge mono">{p.kind === 'reel' ? '▶ Reel' : '❏ Carousel'}</span>}
            </span>
            {p.caption && <span class="ig__cap">{p.caption}</span>}
          </a>
        </li>
      ))}
    </ul>

    <p class="ig__more">
      <a class="btn" href={profile.url} target="_blank" rel="noopener">See all {profile.posts} posts on Instagram ↗</a>
    </p>
  </div>

  <dialog class="ig-view" aria-label="Instagram post">
    <div class="ig-view__inner">
      <div class="ig-view__media"></div>
      <aside class="ig-view__side">
        <div class="ig-view__who">
          {avatar && <img src={avatar.src} alt="" width="36" height="36" />}
          <b>@{profile.handle}</b>
          <span class="ig-view__kind mono faint"></span>
        </div>
        <p class="ig-view__caption"></p>
        <div class="ig-view__actions">
          <a class="btn btn--primary ig-view__open" href="#" target="_blank" rel="noopener">Open on Instagram ↗</a>
        </div>
      </aside>
      <button class="ig-view__nav ig-view__prev" type="button" aria-label="Previous post">‹</button>
      <button class="ig-view__nav ig-view__next" type="button" aria-label="Next post">›</button>
      <button class="ig-view__close" type="button" aria-label="Close">×</button>
    </div>
  </dialog>
  <script type="application/json" id="ig-data" set:html={JSON.stringify(viewerData)} />
</BaseLayout>

<script src="../scripts/instagram-viewer.ts"></script>
