---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import instagram from '../data/instagram.json';

type Kind = 'photo' | 'carousel' | 'reel';
type RawSlide = { type: 'image'; src: string } | { type: 'video'; src: string; poster: string; w: number; h: number };

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/instagram/**/*.{jpg,webp}', { eager: true });
const asset = (name: string): ImageMetadata => {
  const mod = files[`../assets/instagram/${name}`];
  if (!mod) throw new Error(`Missing Instagram asset: ${name}`);
  return mod.default;
};
const large = async (src: ImageMetadata) =>
  (await getImage({ src, width: Math.min(1440, src.width), format: 'webp', quality: 80 })).src;

const { profile } = instagram;

const posts = await Promise.all(
  instagram.posts.map(async (p) => {
    const raw = p.slides as RawSlide[];
    const slides = await Promise.all(
      raw.map(async (s) => {
        if (s.type === 'image') {
          const img = asset(s.src);
          return { type: 'image' as const, src: await large(img), w: img.width, h: img.height };
        }
        return { type: 'video' as const, src: s.src, poster: await large(asset(s.poster)), w: s.w, h: s.h };
      }),
    );
    const first = raw[0];
    const cover = asset(first.type === 'image' ? first.src : first.poster);
    const thumb = await getImage({ src: cover, width: 540, format: 'webp', quality: 72 });
    return {
      code: p.code,
      url: p.url,
      kind: p.kind as Kind,
      pinned: p.pinned,
      caption: p.caption,
      date: p.date,
      thumb: thumb.src,
      preview: first.type === 'video' ? first.src : null,
      slides,
    };
  }),
);

const avatar = profile.avatar ? await getImage({ src: asset(profile.avatar), width: 320, format: 'webp' }) : null;
const videoCount = posts.reduce((n, p) => n + p.slides.filter((s) => s.type === 'video').length, 0);

const viewerData = posts.map(({ url, kind, caption, date, slides }) => ({ url, kind, caption, date, slides }));
const kindLabel: Record<Kind, string> = { photo: 'Photo', carousel: 'Carousel', reel: 'Reel' };
---
<BaseLayout
  title="Instagram"
  description="Hritik Rai's Instagram — reels, travel films, and photos, playable right here."
  current="instagram"
>
  <div class="wrap ig">
    <header class="ig__head">
      {avatar && <img class="ig__avatar" src={avatar.src} alt="" width="160" height="160" />}
      <div class="ig__who">
        <p class="eyebrow">Instagram · @{profile.handle}</p>
        <h1 class="section-title" data-cipher>Frames.</h1>
        <p class="ig__bio">
          {profile.bio.map((line) => <span>{line}</span>)}
        </p>
        <p class="ig__stats mono faint">{posts.length} posts · {videoCount} films · {profile.category}</p>
        <a class="btn" href={profile.url} target="_blank" rel="noopener">@{profile.handle} on Instagram ↗</a>
      </div>
    </header>

    <ul class="ig__grid">
      {posts.map((p, i) => (
        <li>
          <a class="ig__tile" href={p.url} target="_blank" rel="noopener" data-i={i} aria-label={`${kindLabel[p.kind]}: ${p.caption.slice(0, 80) || 'Instagram post'}`}>
            <img src={p.thumb} alt="" width="540" height="675" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            {p.preview && <video class="ig__preview" data-src={p.preview} muted loop playsinline preload="none" aria-hidden="true"></video>}
            <span class="ig__badges">
              {p.pinned && <span class="ig__badge mono">Pinned</span>}
              {p.kind === 'reel' && <span class="ig__badge mono">▶ Reel</span>}
              {p.kind === 'carousel' && <span class="ig__badge mono">❏ {p.slides.length}</span>}
            </span>
            {p.caption && <span class="ig__cap">{p.caption}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="ig-view" aria-label="Instagram post">
    <div class="ig-view__inner">
      <div class="ig-view__media">
        <div class="ig-view__stage"></div>
        <button class="ig-view__step ig-view__step--prev" type="button" aria-label="Previous slide">‹</button>
        <button class="ig-view__step ig-view__step--next" type="button" aria-label="Next slide">›</button>
        <div class="ig-view__dots" aria-hidden="true"></div>
      </div>
      <aside class="ig-view__side">
        <div class="ig-view__who">
          {avatar && <img src={avatar.src} alt="" width="36" height="36" />}
          <b>@{profile.handle}</b>
          <span class="ig-view__kind mono faint"></span>
        </div>
        <p class="ig-view__caption"></p>
        <div class="ig-view__foot">
          <time class="ig-view__date mono faint"></time>
          <a class="ig-view__open" href="#" target="_blank" rel="noopener">View on Instagram ↗</a>
        </div>
      </aside>
      <button class="ig-view__nav ig-view__prev" type="button" aria-label="Previous post">‹</button>
      <button class="ig-view__nav ig-view__next" type="button" aria-label="Next post">›</button>
      <button class="ig-view__close" type="button" aria-label="Close">×</button>
    </div>
  </dialog>
  <script type="application/json" id="ig-data" set:html={JSON.stringify(viewerData)} />
</BaseLayout>

<script src="../scripts/instagram-viewer.ts"></script>
