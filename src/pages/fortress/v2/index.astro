---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/fortress-v2-scoped.css';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const indexPath = path.join(process.cwd(), 'public/fortress/v2/index.html');
const raw = readFileSync(indexPath, 'utf8');
let bodyInner = (raw.match(/<body>([\s\S]*)<\/body>/)?.[1] ?? '')
  .replace(/<header[\s\S]*?<\/header>\s*/i, '')
  .replace(/<footer[\s\S]*?<\/footer>\s*/i, '');
bodyInner = bodyInner.replace(/^\s*<main[^>]*>/i, '').replace(/<\/main>\s*$/i, '');
---
<BaseLayout
  title="Fortress"
  description="Self-hosted AI and automation stack — public-safe portfolio snapshot (no hosts, paths, or credentials)."
  current="none"
>
  <div class="fortress-v2" set:html={bodyInner} />
</BaseLayout>
